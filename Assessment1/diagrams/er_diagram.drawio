        <mxCell id="57oYu3fQP2OPnWM2x2b5-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;M&lt;/font&gt;" vertex="1">
