        </mxCell>
        <mxCell id="57oYu3fQP2OPnWM2x2b5-9" edge="1" parent="1" source="cars" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1.003;entryY=0.198;entryDx=0;entryDy=0;entryPerimeter=0;" target="bookings" value="">
