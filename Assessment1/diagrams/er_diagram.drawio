        <mxCell id="cars" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;spacingLeft=8;verticalAlign=top;" value="&lt;div align=&quot;center&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;CAR&lt;/b&gt;&lt;/font&gt;&lt;hr&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp;car_id(PK)&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;make&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;model&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;year&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;mileage&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;available_now&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;minimum_rent_period&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;maximum_rent_period&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;daily_rate&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;category&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;eco_rating&lt;/font&gt;&lt;/div&gt;" vertex="1">
